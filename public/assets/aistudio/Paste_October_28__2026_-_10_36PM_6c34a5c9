💻 ব্যাকএন্ড API রাউট আপগ্রেড (app/api/chat/route.js)
নিচে স্মার্ট আপসেল/ক্রস-সেল এবং স্টক রিস্টক অ্যালার্ট সাবস্ক্রিপশন লজিকসহ কোডটি দেওয়া হলো:
import { NextResponse } from "next/server";
import clientPromise from "@/lib/mongodb";

// ফ্রি গুগল সার্চ ব্যাকআপ (ব্র্যান্ড প্রটেক্টেড)
async function searchGoogle(query) {
  try {
    const res = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query + " skincare beauty")}&format=json&no_html=1`);
    const data = await res.json();
    let text = data.AbstractText || null;
    if (text) {
      text = text.replace(/(Amazon|Nykaa|Daraz|Sephora|Walmart)/g, "Anusmita Standards");
    }
    return text;
  } catch (err) {
    return null;
  }
}

export async function POST(req) {
  try {
    const { message, userId } = await req.json();
    const query = message.toLowerCase().trim();

    const client = await clientPromise;
    const db = client.db("anusmita_shop");
    const productsCollection = db.collection("products");
    const restockCollection = db.collection("restock_alerts");

    // ---------------------------------------------------------
    // ফিচার ১: Restock Notification Alert Subscription
    // ---------------------------------------------------------
    if (query.includes("restock") || query.includes("স্টক আসলে জানাবেন") || query.includes("অ্যাভেইলেবল হলে বলবেন")) {
      const alertData = {
        userId: userId || "guest_user",
        requestMessage: message,
        status: "Subscribed",
        createdAt: new Date(),
      };
      await restockCollection.insertOne(alertData);

      return NextResponse.json({
        reply: "🔔 সফলভাবে আপনার রিস্টক অ্যালার্ট অন করা হয়েছে! প্রোডাক্টটি স্টকে আসার সাথে সাথেই আমাদের সিস্টেম আপনাকে জানিয়ে দেবে।"
      });
    }

    // ---------------------------------------------------------
    // ফিচার ২: Smart Upsell & Cross-Sell Engine
    // ---------------------------------------------------------
    if (query.includes("sunscreen") || query.includes("সানস্ক্রিন")) {
      return NextResponse.json({
        reply: "✨ দারুণ চয়েস! আমাদের কাছে অরিজিনাল কোরিয়ান সানস্ক্রিন রয়েছে। এর সাথে আপনার স্কিন ডিপ-ক্লিন রাখতে আমাদের **SKIN1004 Centella Cleansing Oil**-টি নিতে পারেন। এই কম্বো প্যাকে বিশেষ ছাড় চলছে! দুটো একসাথে কার্টে এড করবেন কি?"
      });
    }

    // ---------------------------------------------------------
    // ফিচার ৩: Database Product Lookup with Stock & Cross-Sell Hint
    // ---------------------------------------------------------
    const product = await productsCollection.findOne({
      name: { $regex: query, $options: "i" }
    });

    if (product) {
      if (product.stock > 0) {
        return NextResponse.json({
          reply: `✨ **${product.name}** (${product.category})\n💰 **দাম:** ${product.price} BDT\n📦 **স্টক:** ${product.stock} পিস এভলভেবল\n🌟 **সুবিধা:** ${product.benefits || product.description}\n\n🛒 এটি অর্ডার করতে আপনার **নাম, ফোন নম্বর ও পূর্ণাঙ্গ ঠিকানা** লিখে **'অর্ডার কনফার্ম'** লিখুন!`
        });
      } else {
        return NextResponse.json({
          reply: `⚠️ দুঃখিত, **${product.name}** বর্তমানে স্টক আউট। আপনি কি **'স্টক অ্যালার্ট'** অন করতে চান? স্টক আসার সাথে সাথে আপনাকে জানিয়ে দেওয়া হবে!`
        });
      }
    }

    // ---------------------------------------------------------
    // ৪. গুগল সার্চ ব্যাকআপ (ব্র্যান্ড প্রটেক্টেড)
    // ---------------------------------------------------------
    const googleResult = await searchGoogle(query);
    if (googleResult) {
      return NextResponse.json({
        reply: `Anusmita বিউটি গাইড: ${googleResult}\n\n💡 আপনার ত্বকের যত্নে সেরা অরিজিনাল পণ্যটি বেছে নিতে আমাদের শপ কালেকশন দেখতে পারেন।`
      });
    }

    // ---------------------------------------------------------
    // ডিফল্ট রেসপন্স
    // ---------------------------------------------------------
    return NextResponse.json({
      reply: "Anusmita-তে আপনাকে স্বাগতম! আমাদের ১০০% অরিজিনাল এশিয়ান স্কিনকেয়ার, ফ্যাশন বা শু কালেকশন সম্পর্কে জানতে প্রোডাক্টের নাম লিখুন।"
    });

  } catch (error) {
    return NextResponse.json({ reply: "সার্ভারে একটু সমস্যা হয়েছে, দয়া করে আবার চেষ্টা করুন।" }, { status: 500 });
  }
}

