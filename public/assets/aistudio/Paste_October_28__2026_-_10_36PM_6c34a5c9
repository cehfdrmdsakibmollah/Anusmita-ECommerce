💻 সম্পূর্ণ কোড ইমপ্লিমেন্টেশন (Next.js & MongoDB)
১. কন্টাক্ট পেইজে চ্যাটবট উইজেট (app/contact/page.js)
চ্যাটবটটি কেবল কন্টাক্ট পেইজেই শো করবে:
'use client';
import { useState } from 'react';

export default function ContactPage() {
  const [messages, setMessages] = useState([
    { sender: 'bot', text: 'হ্যালো! Anusmita-তে আপনাকে স্বাগতম। প্রোডাক্ট সম্পর্কে জানতে বা এখান থেকেই সরাসরি অর্ডার করতে আমাকে জানাতে পারেন!' }
  ]);
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);

  const handleSend = async () => {
    if (!input.trim()) return;

    const userMsg = { sender: 'user', text: input };
    setMessages((prev) => [...prev, userMsg]);
    setInput('');
    setLoading(true);

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: input, userId: 'USER_SESSION_ID' }), // আপনার ইউজার আইডি/সেশন
      });
      const data = await res.json();
      setMessages((prev) => [...prev, { sender: 'bot', text: data.reply }]);
    } catch (err) {
      setMessages((prev) => [...prev, { sender: 'bot', text: 'দুঃখিত, একটু কারিগরি সমস্যা হয়েছে।' }]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="max-w-4xl mx-auto p-6">
      <h1 className="text-3xl font-bold text-[#C0A06B] mb-4">Contact Us - Anusmita</h1>
      <p className="text-gray-300 mb-6">আমাদের সাথে সরাসরি যোগাযোগ করুন অথবা নিচে চ্যাট করে অর্ডার করুন।</p>

      {/* Embedded Chat UI inside Contact Page */}
      <div className="bg-[#1E2533] border border-[#C0A06B]/30 rounded-2xl shadow-xl flex flex-col h-[500px] overflow-hidden">
        <div className="bg-[#1E2533] border-b border-[#C0A06B]/20 p-4 text-[#C0A06B] font-semibold flex items-center justify-between">
          <span>💬 Anusmita AI Order & Support Assistant</span>
          <span className="text-xs text-green-400">● Online</span>
        </div>

        <div className="flex-1 p-4 overflow-y-auto space-y-3 text-sm">
          {messages.map((msg, i) => (
            <div key={i} className={`max-w-[80%] p-3 rounded-xl ${msg.sender === 'user' ? 'bg-[#C0A06B] text-black ml-auto' : 'bg-white/10 text-white border border-white/5'}`}>
              {msg.text}
            </div>
          ))}
          {loading && <div className="text-xs text-[#C0A06B]">Anusmita AI চিন্তা করছে...</div>}
        </div>

        <div className="p-3 bg-[#1E2533] border-t border-[#C0A06B]/20 flex gap-2">
          <input
            type="text"
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onKeyDown={(e) => e.key === 'Enter' && handleSend()}
            placeholder="প্রোডাক্টের নাম বা অর্ডার সম্পর্কিত কিছু লিখুন..."
            className="flex-1 bg-white/5 border border-[#C0A06B]/30 rounded-xl px-4 py-2 text-white text-sm focus:outline-none focus:border-[#C0A06B]"
          />
          <button onClick={handleSend} className="bg-[#C0A06B] text-black font-semibold px-5 py-2 rounded-xl text-sm hover:opacity-90 transition">
            Send
          </button>
        </div>
      </div>
    </div>
  );
}

২. ব্যাকএন্ড API রাউট: গুগল সার্চ ফিল্টার + অটোমেটিক অর্ডার ডাটাবেসে সেভ (app/api/chat/route.js)
কাস্টমার যখন নাম, মোবাইল নম্বর ও ঠিকানা দিয়ে চ্যাটবটে অর্ডার দেবে, ব্যাকএন্ড কোড সরাসরি MongoDB-র orders কালেকশনে নতুন অর্ডার সেভ করে দেবে, যাতে কাস্টমার তার Order Page (/orders)-এ আগের অর্ডারগুলোর সাথে এটিও দেখতে পায়!
import { NextResponse } from "next/server";
import clientPromise from "@/lib/mongodb";

// ফ্রি সার্চ ইঞ্জিন ব্যাকআপ (DuckDuckGo Search Proxy)
async function searchGoogle(query) {
  try {
