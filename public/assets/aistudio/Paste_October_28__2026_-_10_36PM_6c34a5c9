async function searchFreeKnowledge(query) {
  try {
    const res = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query + " skincare beauty trend")}&format=json&no_html=1`);
    const data = await res.json();
    let text = data.AbstractText || null;
    
    if (text) {
      // ব্র্যান্ড প্রটেকশন ফিল্টার: অন্য কোনো ব্র্যান্ডের নাম থাকলে Anusmita দিয়ে রিপ্লেস করা
      text = text.replace(/(Amazon|Nykaa|Daraz|Sephora|Walmart)/g, "Anusmita Standards");
    }
    return text;
  } catch (err) {
    return null;
  }
}

