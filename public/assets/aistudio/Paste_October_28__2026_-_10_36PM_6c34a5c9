নিচে স্মার্ট অর্ডার এক্সট্র্যাকশন, কুপন হ্যান্ডলিং এবং অটো-কার্ট সামারি সমেত আপডেট করা ব্যাকএন্ড লজিক দেওয়া হলো:
import { NextResponse } from "next/server";
import clientPromise from "@/lib/mongodb";

// ফ্রি গুগল সার্চ ব্যাকআপ (Anusmita ব্র্যান্ড টোনে ফিল্টার করা)
async function searchGoogle(query) {
  try {
    const res = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query + " skincare beauty")}&format=json&no_html=1`);
    const data = await res.json();
    let text = data.AbstractText || null;
    if (text) {
      text = text.replace(/(Amazon|Nykaa|Daraz|Sephora|Walmart)/g, "Anusmita Standards");
    }
    return text;
  } catch (err) {
    return null;
  }
}

export async function POST(req) {
  try {
    const { message, userId, uploadedImage } = await req.json();
    const query = message.toLowerCase().trim();

    const client = await clientPromise;
    const db = client.db("anusmita_shop");
    const productsCollection = db.collection("products");
    const ordersCollection = db.collection("orders");

    // ---------------------------------------------------------
    // ফিচার ১: Image Upload / Visual Match (ছবি আপলোড হ্যান্ডলিং)
    // ---------------------------------------------------------
    if (uploadedImage) {
      // এখানে ইমেজ অ্যানালাইসিস বা ডাটাবেস ইমেজ ম্যাচিং লজিক কাজ করবে
      return NextResponse.json({
        reply: "📸 আপনার পাঠানো ছবিটি আমাদের ক্যাটালগের সাথে মিলিয়ে দেখা হয়েছে। আমাদের কাছে এই ক্যাটাগরির সেরা প্রিমিয়াম কালেকশন রয়েছে। আপনি কি এটি অর্ডার করতে চান?"
      });
    }

    // ---------------------------------------------------------
    // ফিচার ২: Smart Coupon Code & Discount Handler (কুপন চেক)
    // ---------------------------------------------------------
    if (query.includes("coupon") || query.includes("discount") || query.includes("কুপন")) {
      if (query.includes("anusmita10")) {
        return NextResponse.json({
          reply: "🎉 অভিনন্দন! আপনার জন্য 'ANUSMITA10' কুপন কোডটি অ্যাপ্লাই করা হয়েছে। আপনার টোটাল বিলের ওপর ১০% ডিসকাউন্ট উপভোগ করুন!"
        });
      } else {
        return NextResponse.json({
          reply: "ব্যাবহার করার জন্য একটি ভ্যালিড কুপন কোড দিন (যেমন: ANUSMITA10)।"
        });
      }
    }

    // ---------------------------------------------------------
    // ফিচার ৩: Smart Natural Language Order & Address Extraction
    // ---------------------------------------------------------
    if (query.includes("অর্ডার") || query.includes("confirm") || query.includes("দাবো") || query.includes("পাঠিয়ে দিন")) {
      
      // চ্যাট মেসেজ থেকে অটো ডিটেক্ট বা নোট হিসেবে সম্পূর্ণ টেক্সট সেভ করা
      const newOrder = {
        userId: userId || "guest_user",
        source: "AI Chatbot (Smart Extraction)",
        rawCustomerText: message,
        items: [{ name: "Chat-Selected Product", quantity: 1 }],
        status: "Pending Verification",
        createdAt: new Date(),
      };

      await ordersCollection.insertOne(newOrder);

      return NextResponse.json({
        reply: "✅ দারুণ! আপনার মেসেজ থেকে অর্ডার ইনফো সফলভাবে এক্সট্রাক্ট করে আমাদের সিস্টেমে সেভ করা হয়েছে। খুব শীঘ্রই আমাদের প্রতিনিধি কল করে কনফার্ম করবেন। আপনার 'My Orders' পেজে এটি দেখতে পাবেন!"
      });
    }

    // ---------------------------------------------------------
    // ফিচার ৪: Order Tracking (অর্ডার স্ট্যাটাস চেক)
    // ---------------------------------------------------------
    if (query.includes("tracking") || query.includes("স্ট্যাটাস") || query.includes("অর্ডার কোথায়")) {
      const lastOrder = await ordersCollection.findOne({ userId: userId || "guest_user" }, { sort: { createdAt: -1 } });

      if (lastOrder) {
        return NextResponse.json({
          reply: `📦 আপনার সর্বশেষ অর্ডারের তথ্য:\n\n🆔 Order ID: ${lastOrder._id}\n📌 স্ট্যাটাস: **${lastOrder.status}**\n📅 তারিখ: ${new Date(lastOrder.createdAt).toLocaleDateString()}\n\nখুব শীঘ্রই পার্সেল আপনার ঠিকানায় পৌঁছে যাবে!`
