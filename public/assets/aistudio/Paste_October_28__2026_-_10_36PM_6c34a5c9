    // ---------------------------------------------------------
    const product = await productsCollection.findOne({
      name: { $regex: query, $options: "i" }
    });

    if (product) {
      if (product.stock > 0) {
        return NextResponse.json({
          reply: `✨ **${product.name}** (${product.category})\n💰 **দাম:** ${product.price} BDT\n🌟 **সুবিধা:** ${product.benefits || product.description}\n\n🛒 এটি নিতে চাইলে আপনার **নাম, ফোন নম্বর ও পূর্ণাঙ্গ ঠিকানা** লিখে পাঠিয়ে দিন!`
        });
      } else {
        return NextResponse.json({
          reply: `⚠️ দুঃখিত, **${product.name}** বর্তমানে স্টকে নেই। তবে আপনি চাইলে **প্রি-অর্ডার** করতে পারেন। পরবর্তী শিপমেন্টে আপনার ঠিকানায় পৌঁছে যাবে!`
