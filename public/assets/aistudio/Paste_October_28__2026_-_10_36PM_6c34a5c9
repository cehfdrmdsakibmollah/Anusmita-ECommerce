💻 টেকনিক্যাল ইমপ্লিমেন্টেশন কোড (Next.js & JavaScript)
ক. ফ্রন্টএন্ড চ্যাটবটে সাউন্ড ও ডাইনামিক রেসপন্স হ্যান্ডলার (app/contact/page.js)
নিচে ব্রাউজারের বিল্ট-ইন Audio অবজেক্ট ব্যবহার করে কোনো এক্সটার্নাল লাইব্রেরি ছাড়াই সফট সাউন্ড বাজানোর কোড দেওয়া হলো:
'use client';
import { useState, useEffect, useRef } from 'react';

export default function AnusmitaChatBot() {
  const [messages, setMessages] = useState([
    { sender: 'bot', text: '🌸 আসসালামু আলাইকুম! Anusmita-তে আপনাকে স্বাগতম। আজ আপনাকে কীভাবে সাহায্য করতে পারি?' }
  ]);
  const [input, setInput] = useState('');
  const chatEndRef = useRef(null);

  // 🔔 সফট নোটিফিকেশন সাউন্ড প্লে করার ফাংশন (অনলাইন ফ্রি অডিও লিংক ব্যবহার করে)
  const playSound = (type) => {
    try {
      // আপনি চাইলে আপনার প্রজেক্টের public ফোল্ডারে লোকাল mp3 ফাইল রাখতে পারেন (যেমন: /sounds/pop.mp3)
      const audioUrl = type === 'open' 
        ? 'https://assets.mixkit.co/active_storage/sfx/2354/2354-preview.mp3' // সফট ওপেন সাউন্ড
        : 'https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3'; // সফট মেসেজ রিসিভ সাউন্ড
      
      const audio = new Audio(audioUrl);
      audio.volume = 0.4; // ভলিউম মৃদু (soft) রাখার জন্য
      audio.play().catch(e => console.log("Audio play blocked by browser:", e));
    } catch (err) {
      console.log("Sound error:", err);
    }
  };

  // চ্যাট ওপেন হওয়ার সময় সাউন্ড বাজবে
  useEffect(() => {
    playSound('open');
  }, []);

  // অটো স্ক্রোল টু বটম
  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  const handleSendMessage = async (e) => {
    e.preventDefault();
    if (!input.trim()) return;

    const userMsg = input;
    setMessages(prev => [...prev, { sender: 'user', text: userMsg }]);
    setInput('');

    try {
      // ব্যাকএন্ড API-এ রিকোয়েস্ট পাঠানো
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: userMsg })
      });
      const data = await res.json();

      // বটের উত্তর আসার সাথে সাথে সফট নোটিফিকেশন সাউন্ড বাজবে
      playSound('message');
      setMessages(prev => [...prev, { sender: 'bot', text: data.reply }]);
    } catch (err) {
      setMessages(prev => [...prev, { sender: 'bot', text: 'দুঃখিত, সার্ভারে কানেক্ট করতে সমস্যা হচ্ছে।' }]);
    }
  };

  return (
    <div className="max-w-md mx-auto my-8 bg-white border border-[#C0A06B]/30 rounded-3xl shadow-2xl overflow-hidden flex flex-col h-[550px] text-[#1E2533]">
      
      {/* চ্যাট হেডার */}
      <div className="bg-[#1E2533] text-[#C0A06B] p-4 font-bold flex justify-between items-center border-b border-[#C0A06B]/30">
        <span className="flex items-center gap-2">🟢 Anusmita AI Assistant</span>
        <span className="text-xs text-white/70">100% Secure & Free</span>
      </div>

      {/* চ্যাট মেসেজ বক্স */}
      <div className="flex-1 p-4 overflow-y-auto space-y-3 bg-[#1E2533]/5 text-xs">
        {messages.map((msg, idx) => (
          <div key={idx} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
            <div className={`max-w-[80%] p-3 rounded-2xl shadow-sm ${
              msg.sender === 'user' 
                ? 'bg-[#1E2533] text-white rounded-br-none' 
                : 'bg-white text-[#1E2533] border border-[#C0A06B]/30 rounded-bl-none font-medium'
            }`}>
              {msg.text}
            </div>
          </div>
        ))}
        <div ref={chatEndRef} />
      </div>

      {/* ইনপুট ফর্ম */}
      <form onSubmit={handleSendMessage} className="p-3 bg-white border-t border-gray-200 flex gap-2">
        <input 
          type="text"
          value={input}
          onChange={(e) => setInput(e.target.value)}
          placeholder="এখানে আপনার মেসেজ লিখুন..."
          className="flex-1 p-3 border border-gray-300 rounded-2xl text-xs focus:outline-none focus:border-[#C0A06B]"
        />
        <button type="submit" className="bg-[#1E2533] text-[#C0A06B] px-5 rounded-2xl font-bold text-xs shadow-md hover:opacity-90 transition">
          Send
        </button>
      </form>
    </div>
  );
}

খ. এডমিন প্যানেল থেকে চ্যাটবট রেসপন্স ম্যানেজ করার ব্যাকএন্ড API (app/api/chat/route.js)
কোডে ফিক্সড উত্তর রাখার পরিবর্তে এটি ডাটাবেসের chatbot_responses কালেকশন থেকে ডাটা চেক করবে। এডমিন প্যানেল থেকে কেউ উত্তর চেঞ্জ করলেই চ্যাটবট সাথে সাথে সেই নতুন উত্তর দেওয়া শুরু করবে!
import { NextResponse } from "next/server";
import clientPromise from "@/lib/mongodb";

export async function POST(req) {
  try {
    const { message } = await req.json();
    const query = message.toLowerCase().trim();

    const client = await clientPromise;
    const db = client.db("anusmita_shop");
    const responsesCollection = db.collection("chatbot_responses");
    const productsCollection = db.collection("products");

    // ১. প্রথমে এডমিন প্যানেল থেকে সেভ করা ডাটাবেস রেসপন্সগুলো চেক করবে
    const customResponse = await responsesCollection.findOne({
      keyword: { $regex: query, $options: "i" }
    });

    if (customResponse) {
      return NextResponse.json({ reply: customResponse.replyText });
    }

    // ২. প্রোডাক্ট স্টক বা নাম ম্যাচিং চেক
    const product = await productsCollection.findOne({
      name: { $regex: query, $options: "i" }
    });

    if (product) {
      return NextResponse.json({
        reply: `✨ **${product.name}**\n💰 দাম: ${product.price} BDT\n📦 স্টক: ${product.stock > 0 ? `${product.stock} টি অ্যাভেইলেবল` : 'স্টক আউট'}\n\nএটি নিতে চাইলে আপনার নাম ও ঠিকানা লিখে অর্ডার কনফার্ম করুন!`
      });
    }

    // ৩. ডিফল্ট ব্র্যান্ড রেসপন্স
    return NextResponse.json({
      reply: "Anusmita-তে আপনাকে স্বাগতম! আমাদের ১০০% অরিজিনাল এশিয়ান স্কিনকেয়ার বা ফ্যাশন কালেকশন সম্পর্কে জানতে যেকোনো পণ্যের নাম লিখে জানান।"
    });

  } catch (error) {
    return NextResponse.json({ reply: "সার্ভারে একটু সমস্যা হয়েছে, দয়া করে আবার চেষ্টা করুন।" }, { status: 500 });
  }
}

