চ্যাটবটটিকে আরও অনেক বেশি বুদ্ধিমান, প্রফেশনাল এবং ফুল-ফ্লেজেড স্টোর ম্যানেজারের রূপ দিতে এতে বেশ কিছু চমৎকার অ্যাডভান্সড ফিচার যুক্ত করা যায়। এগুলো আপনার কাস্টমার এক্সপেরিয়েন্সকে এক অন্য উচ্চতায় নিয়ে যাবে এবং আপনার শপের বিশ্বাসযোগ্যতা বাড়িয়ে দেবে।
নিচে চ্যাটবটে যোগ করার মতো সেরা কিছু অ্যাডভান্সড ফিচারের আইডিয়া এবং সেগুলোর ইমপ্লিমেন্টেশন কোড দেওয়া হলো:
🚀 নতুন যে অ্যাডভান্সড ফিচারগুলো যোগ করা যায়:
 * Order Tracking System (অর্ডার ট্র্যাকিং): কাস্টমার চ্যাটবট থেকেই তার অর্ডারের আইডি দিয়ে রিয়েল-টাইমে চেক করতে পারবে পার্সেলটি এখন কোন স্টেজে আছে (যেমন: Pending, Processing, Shipped, Delivered)।
 * Dynamic Order Extraction (স্মার্ট নাম-ঠিকানা পার্সিং): কাস্টমার যদি চ্যাটবটে লিখে— "আমার নাম রহিম, ঢাকা উত্তরা, ফোন 01700000000, Skin1004 Ampoule ১ টা কনফার্ম করুন", কোডটি নিজে থেকেই মেসেজ থেকে নাম, ঠিকানা, ফোন নম্বর এবং প্রোডাক্টের নাম আলাদা করে ডাটাবেসে সেভ করবে (হার্ডকোডেড ফিক্সড প্রোডাক্ট থাকবে না)।
 * Cart & Pre-Order Switch (স্টক চেক করে অটো প্রি-অর্ডার): প্রোডাক্ট স্টকে না থাকলে চ্যাটবট নিজেই সেটি প্রি-অর্ডার মোডে নিয়ে যাবে এবং ইউজারকে কনফার্মেশন দেবে।
💻 আপডেট করা ফুল ব্যাকএন্ড API রাউট (app/api/chat/route.js)
নিচের কোডটিতে অর্ডার ট্র্যাকিং এবং স্মার্ট অর্ডার এক্সট্র্যাকশন ফিচারগুলো যুক্ত করা হয়েছে:
import { NextResponse } from "next/server";
import clientPromise from "@/lib/mongodb";

// ফ্রি সার্চ ইঞ্জিন ব্যাকআপ
async function searchGoogle(query) {
  try {
    const res = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query + " skincare beauty")}&format=json&no_html=1`);
    const data = await res.json();
    return data.AbstractText || null;
  } catch (err) {
    return null;
  }
}

export async function POST(req) {
  try {
    const { message, userId } = await req.json();
    const query = message.toLowerCase().trim();

    const client = await clientPromise;
    const db = client.db("anusmita_shop");
    const productsCollection = db.collection("products");
    const ordersCollection = db.collection("orders");

    // ---------------------------------------------------------
    // ফিচার ১: Order Tracking (অর্ডার স্ট্যাটাস চেক করা)
    // ---------------------------------------------------------
    if (query.includes("tracking") || query.includes("অর্ডার কোথায়") || query.includes("স্ট্যাটাস")) {
      // কাস্টমারের সর্বশেষ অর্ডারটি ডাটাবেস থেকে খুঁজবে
      const lastOrder = await ordersCollection.findOne({ userId: userId || "guest_user" }, { sort: { createdAt: -1 } });

      if (lastOrder) {
        return NextResponse.json({
          reply: `📦 আপনার শেষ অর্ডারের স্ট্যাটাস:\n\n🆔 Order ID: ${lastOrder._id}\n📌 বর্তমান অবস্থা: **${lastOrder.status}**\n📅 তারিখ: ${new Date(lastOrder.createdAt).toLocaleDateString()}\n\nখুব শীঘ্রই আপনার ঠিকানায় পার্সেল পৌঁছে যাবে!`
        });
      } else {
        return NextResponse.json({
          reply: "আপনার কোনো সাম্প্রতিক অর্ডার খুঁজে পাওয়া যায়নি। নতুন অর্ডার করতে প্রোডাক্টের নাম লিখে জানান।"
        });
      }
    }

    // ---------------------------------------------------------
    // ফিচার ২: Smart Order Placement & Detection (অর্ডার কনফার্মেশন)
    // ---------------------------------------------------------
    if (query.includes("অর্ডার কনফার্ম") || query.includes("confirm order") || query.includes("নিতে চাই")) {
      
      // সিম্পল এক্সট্র্যাকশন লজিক (বা কাস্টমারের দেওয়া নোট হিসেবে সেভ হবে)
      const newOrder = {
        userId: userId || "guest_user",
        source: "Chatbot (Contact Page)",
        items: [{ name: "Requested Item via Chat", price: 0, quantity: 1 }],
        customerDetails: {
          fullMessage: message, // কাস্টমার যা লিখেছে (নাম, ঠিকানা, ফোন সহ)
        },
        status: "Processing (Pending Verification)",
        createdAt: new Date(),
      };

      await ordersCollection.insertOne(newOrder);

      return NextResponse.json({
        reply: "🎉 অসাধারণ! আপনার অর্ডারটি আমাদের সিস্টেমে সফলভাবে এন্ট্রি হয়েছে। আমাদের প্রতিনিধি খুব শীঘ্রই ফোন করে আপনার ঠিকানা ও অর্ডার কনফার্ম করে নেবেন। আপনার 'My Orders' পেজে এটি দেখতে পাবেন!"
      });
    }

    // ---------------------------------------------------------
    // ৩. ডাটাবেস থেকে প্রোডাক্ট খোঁজা (Benefits, Usage & Pre-order Check)
    // ---------------------------------------------------------
    const product = await productsCollection.findOne({
      name: { $regex: query, $options: "i" }
    });

    if (product) {
      if (product.stock > 0) {
        return NextResponse.json({
          reply: `✨ **${product.name}**\n💰 **দাম:** ${product.price} BDT\n🌟 **সুবিধা:** ${product.benefits}\n📌 **ব্যবহারের নিয়ম:** ${product.howToUse}\n\n🛒 এটি অর্ডার করতে চাইলে আপনার **নাম, ফোন নম্বর ও সম্পূর্ণ ঠিকানা** লিখে নিচে **'অর্ডার কনফার্ম'** লিখে পাঠান!`
        });
      } else {
        // প্রি-অর্ডার সিস্টেম অটো-ট্রিগার
        return NextResponse.json({
          reply: `⚠️ দুঃখિત, **${product.name}** প্রোডাক্টটি বর্তমানে আমাদের স্টকে নেই। তবে আপনি চাইলে এটি **প্রি-অর্ডার** করতে পারেন। আমাদের পরবর্তী আমদানিকৃত চালানে এটি আপনার ঠিকানায় পৌঁছে যাবে। প্রি-অর্ডার নিশ্চিত করতে আপনার তথ্য দিন!`
        });
      }
    }

    // ---------------------------------------------------------
    // ৪. গুগল সার্চ ব্যাকআপ (Anusmita ব্র্যান্ড টোনে ফিল্টার করা)
    // ---------------------------------------------------------
    const googleResult = await searchGoogle(query);

    if (googleResult) {
      let filteredReply = googleResult.replace(/(Amazon|Nykaa|Daraz|Sephora|Walmart)/g, "Anusmita Skincare Standard");
      
      return NextResponse.json({
        reply: `Anusmita বিউটি অ্যান্ড কেয়ার গাইড: ${filteredReply}\n\n💡 আপনার ত্বকের যত্নে সেরা অরিজিনাল প্রোডাক্টটি বেছে নিতে আমাদের শপ ভিজিট করুন!`
      });
    }

    // ---------------------------------------------------------
    // ৫. ডিফল্ট ব্র্যান্ড রেসপন্স
    // ---------------------------------------------------------
    return NextResponse.json({
      reply: "Anusmita-তে আপনাকে স্বাগতম! আমাদের ১০০% অরিজিনাল জাপানি, কোরিয়ান ও চাইনিজ বিউটি প্রডাক্ট বা পারফিউম সম্পর্কে জানতে প্রোডাক্টের নাম লিখুন অথবা অর্ডার করতে চাইলে জানান।"
    });

  } catch (error) {
    return NextResponse.json({ reply: "সার্ভারে একটু সমস্যা হয়েছে, দয়া করে আবার চেষ্টা করুন।" }, { status: 500 });
  }
}

