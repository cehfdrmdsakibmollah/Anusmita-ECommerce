            <div className="space-y-3 text-xs">
              <div>
                <label className="font-semibold text-gray-600">Your Height (e.g., 5 ft 6 in):</label>
                <input 
                  type="text" 
                  value={height} 
                  onChange={(e) => setHeight(e.target.value)} 
                  placeholder="Enter height"
                  className="w-full mt-1 p-3 border border-gray-300 rounded-xl focus:outline-none focus:border-[#C0A06B]"
                />
              </div>
              <div>
                <label className="font-semibold text-gray-600">Your Weight (e.g., 65 kg):</label>
                <input 
                  type="text" 
                  value={weight} 
                  onChange={(e) => setWeight(e.target.value)} 
                  placeholder="Enter weight in kg"
                  className="w-full mt-1 p-3 border border-gray-300 rounded-xl focus:outline-none focus:border-[#C0A06B]"
                />
              </div>

              <button 
                onClick={calculateSize}
                className="w-full bg-[#C0A06B] text-black font-bold py-3 rounded-xl shadow-md hover:opacity-90 transition"
              >
                Calculate Best Size
              </button>

              {suggestedSize && (
                <div className="p-3 bg-[#1E2533] text-white rounded-xl text-center space-y-1">
                  <p className="text-gray-300">Recommended Size for You:</p>
                  <p className="text-lg font-extrabold text-[#C0A06B]">{suggestedSize}</p>
