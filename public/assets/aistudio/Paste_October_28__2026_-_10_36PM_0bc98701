💻 Next.js অ্যাডভান্সড কম্পোনেন্ট কোড স্ট্রাকচার (app/product/[id]/page.js)
নিচে সম্পূর্ণ ডায়নামিক ও ক্যাটাগরি-অ্যাওয়্যার প্রফেশনাল প্রোডাক্ট ডিটেইলস পেজের কোড দেওয়া হলো:
'use client';
import { useState } from 'react';
import Link from 'next/link';

export default function AdvancedProductDetails({ product }) {
  const [selectedColor, setSelectedColor] = useState(product?.variants?.[0]?.color || null);
  const [selectedSize, setSelectedSize] = useState(product?.sizes?.[0] || null);
  const [activeTab, setActiveTab] = useState('details');

  // ডাইনামিক কারেন্ট ইমেজ সিলেক্টর
  const currentVariant = product?.variants?.find(v => v.color === selectedColor);
  const currentImage = currentVariant?.image || product?.mainImage || '/placeholder.jpg';

  // স্টক হিসাব
  const currentStock = currentVariant?.stock ?? product?.stockQuantity ?? 0;

  return (
    <div className="max-w-7xl mx-auto p-4 md:p-8 text-[#1E2533] space-y-12">
      
      {/* -------------------------------------------------------------
          ১. মেইন গ্রিড: প্রোডাক্ট গ্যালারি + ডায়নামিক ভ্যারিয়েন্ট প্যানেল
      ------------------------------------------------------------- */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-10">
        
        {/* প্রোডাক্ট ইমেজ ভিউয়ার */}
        <div className="space-y-4">
          <div className="bg-[#1E2533]/5 p-6 rounded-3xl border border-[#C0A06B]/30 flex items-center justify-center relative overflow-hidden group">
            <img 
              src={currentImage} 
              alt={product.name}
              className="max-h-[480px] w-auto object-contain rounded-2xl transition duration-500 group-hover:scale-105"
            />
            {product.discountPercent > 0 && (
              <span className="absolute top-4 left-4 bg-[#C0A06B] text-black font-bold px-3 py-1 rounded-full text-xs shadow-md">
                -{product.discountPercent}% OFF
              </span>
            )}
          </div>
        </div>

        {/* ডায়নামিক ইনফো ও অ্যাকশন সেকশন */}
        <div className="space-y-6">
          <div className="flex items-center gap-2">
            <span className="px-3 py-1 bg-[#1E2533] text-[#C0A06B] rounded-full text-xs font-semibold tracking-wide uppercase">
              {product.category}
            </span>
            <span className="text-xs text-gray-500">SKU: {product.sku || 'ANUS-001'}</span>
          </div>

          <h1 className="text-3xl md:text-4xl font-extrabold text-[#1E2533]">{product.name}</h1>

          {/* দাম ও স্টক অ্যালার্ট */}
          <div className="flex items-center gap-4">
            <span className="text-3xl font-bold text-[#C0A06B]">৳ {product.price}</span>
            {product.oldPrice && (
              <span className="text-lg text-gray-400 line-through">৳ {product.oldPrice}</span>
            )}
            
            {/* স্টক অ্যালার্ট ব্যাজ */}
            {currentStock > 0 && currentStock <= 3 ? (
              <span className="px-3 py-1 bg-red-100 text-red-600 rounded-lg text-xs font-bold animate-pulse">
                ⚠️ Only {currentStock} left in stock!
              </span>
            ) : currentStock === 0 ? (
              <span className="px-3 py-1 bg-amber-100 text-amber-700 rounded-lg text-xs font-bold">
                ✈️ Available for Pre-Order
              </span>
            ) : (
              <span className="px-3 py-1 bg-green-100 text-green-700 rounded-lg text-xs font-bold">
                ✓ In Stock
              </span>
            )}
          </div>

          <p className="text-gray-600 text-sm leading-relaxed">{product.description}</p>

          {/* 🎨 কালার সচেস (Fashion, Shoes, Bags, Bedsheets-এর জন্য) */}
          {product.variants && product.variants.length > 0 && (
            <div className="space-y-2">
              <label className="text-xs font-bold uppercase tracking-wider text-[#1E2533]/80">
                Select Color: <span className="text-[#C0A06B] font-extrabold">{selectedColor}</span>
              </label>
              <div className="flex gap-3">
                {product.variants.map((v) => (
                  <button
                    key={v.color}
                    onClick={() => setSelectedColor(v.color)}
                    className={`px-4 py-2 rounded-xl border text-sm font-medium transition ${
                      selectedColor === v.color
                        ? 'border-[#C0A06B] bg-[#1E2533] text-[#C0A06B] shadow-lg'
                        : 'border-gray-200 bg-gray-50 text-gray-700 hover:border-[#C0A06B]'
                    }`}
                  >
                    {v.color}
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* 📐 সাইজ সিলেক্টর (Category Aware) */}
          {product.sizes && product.sizes.length > 0 && (
            <div className="space-y-2">
              <div className="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-[#1E2533]/80">
                <span>
                  {product.category === 'Shoes' ? 'Select EU Shoe Size:' : 
                   product.category === 'Home Decor' ? 'Bed Size:' : 'Select Size:'}
                </span>
                {product.sizeGuide && (
                  <button className="text-[#C0A06B] underline lowercase text-xs">View Size Guide</button>
                )}
              </div>
              <div className="flex flex-wrap gap-2">
                {product.sizes.map((s) => (
                  <button
                    key={s}
