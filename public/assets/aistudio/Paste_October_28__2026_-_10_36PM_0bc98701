          {product.compatibility && (
            <div className="p-3 bg-gray-50 border border-gray-200 rounded-xl text-xs space-y-1">
              <span className="font-bold text-[#1E2533]">📱 Device Compatibility:</span>
              <p className="text-gray-600">{product.compatibility}</p>
            </div>
          )}

          {/* 🛒 কার্ট & অর্ডারিং বাটন্স */}
          <div className="flex gap-4 pt-2">
            {currentStock > 0 ? (
              <>
                <button className="flex-1 bg-[#1E2533] text-[#C0A06B] font-bold py-4 rounded-2xl hover:bg-[#1E2533]/90 transition shadow-xl">
                  Add to Cart
                </button>
                <button className="flex-1 bg-[#C0A06B] text-black font-bold py-4 rounded-2xl hover:opacity-90 transition shadow-xl">
                  Buy Now
                </button>
              </>
            ) : (
              <button className="w-full bg-amber-600 text-white font-bold py-4 rounded-2xl hover:bg-amber-700 transition shadow-xl">
                ✈️ Pre-Order This Item
              </button>
            )}
          </div>

          {/* 💬 AI চ্যাটবক্স কোশ্চেন লিংক */}
          <div className="pt-2">
            <Link 
              href={`/contact?product=${encodeURIComponent(product.name)}`}
              className="w-full border border-[#C0A06B]/50 text-[#1E2533] font-semibold py-2.5 rounded-xl flex items-center justify-center gap-2 text-xs hover:bg-[#C0A06B]/10 transition"
            >
              💬 Have questions about this item? Ask Anusmita AI
            </Link>
          </div>
        </div>
      </div>

      {/* -------------------------------------------------------------
          ২. ক্যাটাগরি-অ্যাওয়্যার ডাইনামিক ইনফরমেশন ট্যাবস
