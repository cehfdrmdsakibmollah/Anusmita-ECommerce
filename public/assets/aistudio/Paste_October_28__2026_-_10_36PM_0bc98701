        {product.sizes && product.sizes.length > 0 && (
          <div>
            <h3 className="text-sm font-semibold text-[#C0A06B] mb-2">
              {product.category === 'Shoes' ? 'Select Shoe Size (EU):' : 
               product.category === 'Home Decor' ? 'Select Bed Size:' : 'Select Size:'}
            </h3>
            <div className="flex flex-wrap gap-3">
              {product.sizes.map((s) => (
                <button
                  key={s}
                  onClick={() => setSelectedSize(s)}
                  className={`px-4 py-2 rounded-xl border text-sm ${
                    selectedSize === s 
                      ? 'border-[#C0A06B] bg-[#C0A06B] text-black font-bold' 
                      : 'border-white/20 bg-white/5 text-white'
                  }`}
                >
                  {s}
                </button>
              ))}
            </div>
          </div>
        )}

        {/* 📱 ৩. মোবাইল এক্সেসরিজের জন্য কম্প্যাটিবিলিটি (Model Compatibility) */}
        {product.compatibility && (
          <div className="bg-white/5 p-4 rounded-xl border border-white/10">
            <h3 className="text-xs font-semibold text-[#C0A06B] uppercase mb-1">Device Compatibility:</h3>
            <p className="text-sm text-gray-200">{product.compatibility}</p>
          </div>
        )}

        {/* 🌿 ৪. স্কিনকেয়ার বা পারফিউমের জন্য সুফল ও ব্যবহারের নিয়ম (Skincare Exclusive Details) */}
        {product.category === 'Skincare' && (
          <div className="space-y-3 bg-white/5 p-4 rounded-xl border border-white/10 text-sm">
            <div>
              <span className="font-semibold text-[#C0A06B]">✨ Key Benefits: </span>
              <span className="text-gray-300">{product.benefits}</span>
            </div>
            <div>
              <span className="font-semibold text-[#C0A06B]">📌 How to Use: </span>
              <span className="text-gray-300">{product.howToUse}</span>
            </div>
          </div>
        )}

        {/* 🛒 ৫. কার্ট ও বাই বাটন */}
        <div className="flex gap-4 pt-4">
          <button className="flex-1 bg-[#C0A06B] text-black font-bold py-3.5 rounded-xl hover:opacity-90 transition shadow-lg">
            Add to Cart
          </button>
          <button className="flex-1 bg-white/10 text-white border border-[#C0A06B]/40 font-bold py-3.5 rounded-xl hover:bg-white/20 transition">
            Buy Now
          </button>
        </div>

      </div>
    </div>
  );
}

🌟 এই সিস্টেমের সুবিধা:
 * মাল্টি-ক্যাটারী হ্যান্ডলিং: একটিমাত্র পেজ কোড দিয়েই আপনি জুতো, কাপড়, স্কিনকেয়ার, মোবাইল এক্সেসরিজ বা বেডশিট—সবকিছুর ডেটা অনুযায়ী ডিটেইলস পেজের লেআউট বদলে ফেলতে পারবেন।
 * ক্লিন কোড বেস: আলাদা আলাদা প্রোডাক্টের জন্য ডজন ডজন পেজ বানাতে হবে না। MongoDB থেকে ডাটা ফেচ হয়ে আসার সাথে সাথে পেজটি নিজে থেকেই ক্যাটাগরি চিনে প্রয়োজনীয় সেকশনগুলো ওপেন করে দেবে।
আপনার এই বিশাল ই-কমার্স কালেকশনের জন্য এই ডাইনামিক আর্কিটেকচারটি একদম পারফেক্ট কাজ করবে! এই লেআউট বা কোড নিয়ে আরও কোনো কাস্টমাইজেশন চাচ্ছেন কি?

