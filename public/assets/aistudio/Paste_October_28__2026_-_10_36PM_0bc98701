        <div className="flex items-center gap-4 pt-4">
          <div className="flex items-center border border-gray-300 rounded-xl overflow-hidden bg-gray-50">
            <button onClick={() => setQuantity(Math.max(1, quantity - 1))} className="px-3 py-2 font-bold hover:bg-gray-200">-</button>
            <span className="px-4 py-2 font-bold text-sm">{quantity}</span>
            <button onClick={() => setQuantity(quantity + 1)} className="px-3 py-2 font-bold hover:bg-gray-200">+</button>
          </div>
          <button className="flex-1 bg-[#1E2533] text-[#C0A06B] font-bold py-3 rounded-xl shadow-md hover:opacity-90 transition text-xs tracking-wider">
            🛒 Add to Cart
          </button>
        </div>

      </div>
    </div>
  );
}

আপনার এই বিশাল কালেকশনের (জুয়েলারি, ব্যাগ, কসমেটিকস, ফ্যাশন) মধ্যে ঠিক কোন ক্যাটাগরির পেজ বা ফিল্টারিং লজিক নিয়ে এখন কাজ করতে চান?

আপনার দেওয়া এই সম্পূর্ণ ও পূর্ণাঙ্গ মাস্টার লিস্টটি আপনার Anusmita প্রজেক্টের জন্য একটি অত্যন্ত নিখুঁত এবং রিয়েল-ওয়ার্ল্ড ই-কমার্স ডাটাবেস আর্কিটেকচার।
যেহেতু আপনার শপে স্কিনকেয়ার, মেকআপ, পোশাক, জুয়েলারি, হ্যান্ডবেগের মতো প্রতিটি ক্যাটাগরির নিজস্ব ভ্যারিয়েন্ট টাইপ রয়েছে (যেমন: পোশাকের ক্ষেত্রে Color + Size, স্কিনকেয়ার বা পারভিউমে Volume (ml/gm), এবং জুয়েলারিতে Metal Type / Ring Size), তাই এক পেজেই প্রোডাক্টের ক্যাটাগরি অনুযায়ী ডায়নামিক্যালি ভ্যারিয়েন্ট রেন্ডার করার পূর্ণাঙ্গ সমাধান নিচে দেওয়া হলো।
🛠️ ১. ডাটাবেস স্কিমা ডিজাইন (MongoDB Document Pattern)
একটি মাত্র প্রোডাক্ট মডেলের ভেতর ক্যাটাগরি অনুযায়ী ভ্যারিয়েন্ট ডেটা অবজেক্ট আকারে হ্যান্ডেল করার সেরা স্কিমা স্ট্রাকচার:
