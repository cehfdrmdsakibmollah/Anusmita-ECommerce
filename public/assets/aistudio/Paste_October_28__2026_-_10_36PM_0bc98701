💻 2. ডাইনামিক প্রোডাক্ট ডিটেইলস কম্পোনেন্ট (Next.js & Tailwind CSS)
নিচে একটি প্রোডাকশন-রেডি Next.js ক্লায়েন্ট কম্পোনেন্ট দেওয়া হলো যা প্রোডাক্টের variantType অনুযায়ী ব্রাউজারে স্বয়ংক্রিয়ভাবে সঠিক ইনপুট সিলেক্টরটি রেন্ডার করবে:
'use client';
import { useState } from 'react';

export default function DynamicProductDetails({ product }) {
  // প্রোডাক্টের ডিফল্ট ভ্যারিয়েন্ট স্টেট
  const [selectedVariant, setSelectedVariant] = useState(product?.variants?.[0] || null);
  const [selectedColor, setSelectedColor] = useState(product?.colors?.[0] || null);
  const [quantity, setQuantity] = useState(1);

  // ডায়নামিক প্রাইস ক্যালকুলেশন
  const currentPrice = selectedVariant?.price || product?.price || 0;
  const currentStock = selectedVariant?.stock ?? product?.stock ?? 0;

  return (
    <div className="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-2 gap-10 text-[#1E2533]">
      
      {/* 🖼️ প্রোডাক্ট ইমেজ প্রিভিউ */}
      <div className="space-y-4">
        <div className="border border-[#C0A06B]/30 rounded-3xl overflow-hidden shadow-xl bg-white p-2 relative">
          <img 
            src={product?.image || "https://via.placeholder.com/500"} 
            alt={product?.name} 
            className="w-full h-[450px] object-cover rounded-2xl"
          />
          {currentStock <= 3 && currentStock > 0 && (
            <span className="absolute top-4 left-4 bg-red-600 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider animate-pulse">
              Only {currentStock} Left!
            </span>
          )}
        </div>
      </div>

      {/* 📋 ডাইনামিক ভ্যারিয়েন্ট ও অপশন সেকশন */}
      <div className="space-y-6">
        <div>
          <span className="text-xs bg-[#C0A06B]/20 text-[#C0A06B] px-3 py-1 rounded-full font-extrabold uppercase tracking-widest">
            {product?.category} • {product?.subCategory}
          </span>
          <h1 className="text-2xl md:text-3xl font-extrabold text-[#1E2533] mt-3">{product?.name}</h1>
          
          <div className="flex items-center gap-3 mt-2">
            <p className="text-2xl font-black text-[#C0A06B]">৳ {currentPrice.toLocaleString('bn-BD')}</p>
            {product?.originalPrice && (
              <p className="text-sm text-gray-400 line-through">৳ {product.originalPrice}</p>
            )}
          </div>
        </div>

        <hr className="border-gray-200" />

        {/* ------------------------------------------------------------- */}
        {/* 🧪 কেস ১: স্কিনকেয়ার, বডি কেয়ার, পারফিউম (Volume: ml / gm / pcs) */}
        {/* ------------------------------------------------------------- */}
        {product?.variantType === 'volume' && (
          <div className="space-y-2">
            <label className="text-xs font-bold uppercase tracking-wider text-gray-600">
              Select Size / Volume:
            </label>
            <div className="flex flex-wrap gap-2">
              {product?.variants?.map((v, idx) => (
                <button
                  key={idx}
                  onClick={() => setSelectedVariant(v)}
                  className={`px-4 py-2 rounded-xl text-xs font-bold border transition-all ${
                    selectedVariant?.label === v.label
                      ? 'bg-[#1E2533] text-[#C0A06B] border-[#C0A06B] shadow-md scale-105'
                      : 'bg-white text-gray-700 border-gray-200 hover:border-[#C0A06B]'
                  }`}
                >
                  {v.label}
                </button>
              ))}
            </div>
          </div>
        )}

        {/* ------------------------------------------------------------- */}
        {/* 👗 কেস ২: পোশাক ও ওয়েস্টার্ন ওয়্যার (Clothing: Color + Sizes)  */}
        {/* ------------------------------------------------------------- */}
        {product?.variantType === 'fashion_size' && (
          <div className="space-y-4">
            {/* কালার সিলেক্টর */}
            {product?.colors && (
              <div className="space-y-2">
                <label className="text-xs font-bold uppercase tracking-wider text-gray-600">
                  Select Color: <span className="text-[#1E2533] font-extrabold">{selectedColor?.name}</span>
                </label>
                <div className="flex gap-2">
                  {product.colors.map((c, idx) => (
                    <button
                      key={idx}
                      onClick={() => setSelectedColor(c)}
                      className={`w-8 h-8 rounded-full border-2 transition-all p-0.5 ${
                        selectedColor?.name === c.name ? 'border-[#C0A06B] scale-110 shadow-md' : 'border-gray-200'
                      }`}
                    >
                      <span className="block w-full h-full rounded-full" style={{ backgroundColor: c.hex }}></span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {/* সাইজ সিলেক্টর (S, M, L, XL, XXL) */}
            <div className="space-y-2">
              <label className="text-xs font-bold uppercase tracking-wider text-gray-600">Select Apparel Size:</label>
              <div className="flex flex-wrap gap-2">
                {product?.variants?.map((v, idx) => (
                  <button
                    key={idx}
                    onClick={() => setSelectedVariant(v)}
                    className={`w-12 h-10 rounded-xl text-xs font-bold border transition-all flex items-center justify-center ${
                      selectedVariant?.label === v.label
                        ? 'bg-[#1E2533] text-[#C0A06B] border-[#C0A06B] shadow-md'
                        : 'bg-white text-gray-700 border-gray-200 hover:border-[#C0A06B]'
                    }`}
                  >
                    {v.label}
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ------------------------------------------------------------- */}
        {/* 💍 কেস ৩: জুয়েলারি (Ring Sizes / Plating Specs)             */}
        {/* ------------------------------------------------------------- */}
        {product?.variantType === 'jewelry_spec' && (
          <div className="space-y-3 bg-[#1E2533]/5 p-4 rounded-2xl border border-[#C0A06B]/30">
            <span className="text-xs font-bold text-[#1E2533]">✨ Ring / Bangle Size:</span>
            <div className="flex gap-2">
              {product?.variants?.map((v, idx) => (
                <button
                  key={idx}
                  onClick={() => setSelectedVariant(v)}
                  className={`px-3 py-1.5 rounded-lg text-xs font-bold border ${
                    selectedVariant?.label === v.label
                      ? 'bg-[#1E2533] text-[#C0A06B] border-[#C0A06B]'
                      : 'bg-white text-gray-700 border-gray-200'
                  }`}
                >
                  Size {v.label}
                </button>
              ))}
            </div>
            <p className="text-[11px] text-gray-500 italic">⭐ 18K Anti-Tarnish Gold Plated & Sweatproof Guarantee.</p>
          </div>
        )}

        {/* ------------------------------------------------------------- */}
        {/* 👜 কেস ৪: ব্যাগ, অর্গানাইজার ও হোম ডেকোর (Dimension Specs)   */}
        {/* ------------------------------------------------------------- */}
        {product?.variantType === 'bag_spec' && (
          <div className="p-4 bg-gray-50 border border-gray-200 rounded-2xl text-xs space-y-1">
            <p className="font-bold text-[#1E2533]">👜 Dimensions & Storage Capacity:</p>
            <p className="text-gray-600">Width: {product?.specs?.width || '25cm'} | Height: {product?.specs?.height || '18cm'}</p>
            <p className="text-gray-600">Material: {product?.specs?.material || 'Imported PU Leather'}</p>
          </div>
        )}

        {/* 🛒 কোয়ান্টিটি এবং অ্যাড টু কার্ট অ্যাকশন */}
        <div className="flex items-center gap-4 pt-4">
          <div className="flex items-center border border-gray-300 rounded-2xl overflow-hidden bg-gray-50">
            <button 
              onClick={() => setQuantity(Math.max(1, quantity - 1))}
              className="px-4 py-2.5 font-bold hover:bg-gray-200 text-sm"
            >
              -
            </button>
            <span className="px-4 py-2.5 font-bold text-sm">{quantity}</span>
            <button 
              onClick={() => setQuantity(quantity + 1)}
              className="px-4 py-2.5 font-bold hover:bg-gray-200 text-sm"
            >
              +
            </button>
          </div>

          <button 
            disabled={currentStock <= 0}
            className={`flex-1 py-3.5 rounded-2xl font-extrabold text-xs tracking-wider shadow-lg transition-all ${
              currentStock > 0 
                ? 'bg-[#1E2533] text-[#C0A06B] hover:bg-[#C0A06B] hover:text-[#1E2533]' 
                : 'bg-gray-300 text-gray-500 cursor-not-allowed'
            }`}
          >
            {currentStock > 0 ? '🛒 ADD TO CART' : '❌ OUT OF STOCK'}
          </button>
        </div>

      </div>
    </div>
  );
}

✨ এই আর্কিটেকচারের সুবিধা:
 * স্মার্ট ভ্যারিয়েন্ট সুইচিং: প্রোডাক্টের টাইপ volume, fashion_size, নাকি jewelry_spec—তার ওপর নির্ভর করে স্বয়ংক্রিয়ভাবে সঠিক ইনপুট সুইচ করবে।
 * ডায়নামিক প্রাইস ও স্টক সিঙ্ক: ইউজার 50ml থেকে 100ml অথবা M থেকে XL সাইজে ক্লিক করার সাথে সাথে লাইভ দাম ও স্টক কন্ডিশন আপডেট হবে।
 * ব্র্যান্ড থিম সিঙ্ক: আপনার নির্ধারিত Dark Slate Navy (#1E2533) এবং Champagne Gold (#C0A06B) কালার প্যালেট বজায় রেখে বিশ্বমানের লাক্সারি ফিল প্রদান করবে।


