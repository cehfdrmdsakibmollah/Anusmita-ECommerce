                <option value="Dhaka">Inside Dhaka</option>
                <option value="Outside">Outside Dhaka</option>
              </select>
            </div>
            <p className="text-gray-600">
              Delivery Fee: <strong>৳{deliveryCharge}</strong> | Estimated Arrival: <strong>2-3 Business Days</strong>
            </p>
          </div>

          {/* 👗 / 👟 Dynamic Sizes */}
          {product.sizes && (
            <div className="space-y-2">
              <label className="text-xs font-bold uppercase tracking-wider">
                {product.category === 'Shoes' ? 'Select EU Size:' : 'Select Size:'}
              </label>
              <div className="flex gap-2">
                {product.sizes.map((size) => (
                  <button
                    key={size}
                    onClick={() => setSelectedSize(size)}
                    className={`px-4 py-2 rounded-xl text-sm font-semibold border transition ${
                      selectedSize === size
                        ? 'bg-[#1E2533] text-[#C0A06B] border-[#1E2533]'
                        : 'bg-white text-gray-700 border-gray-200 hover:border-[#C0A06B]'
                    }`}
                  >
                    {size}
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* 🛒 Action Buttons */}
          <div className="flex gap-4 pt-4">
            <button className="flex-1 bg-[#1E2533] text-[#C0A06B] font-bold py-4 rounded-2xl hover:opacity-95 transition">
              Add to Cart
            </button>
            <button className="flex-1 bg-[#C0A06B] text-black font-bold py-4 rounded-2xl hover:opacity-90 transition">
              {product.stockQuantity > 0 ? 'Buy Now' : 'Pre-Order Now'}
            </button>
          </div>

        </div>
      </div>
    </div>
  );
}

