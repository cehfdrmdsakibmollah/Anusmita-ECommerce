            Pre-Order Open
          </span>
        </div>
      )}

      <div className="grid grid-cols-1 md:grid-cols-2 gap-10">
        
        {/* 📸 Dynamic Image Viewer */}
        <div className="bg-[#1E2533]/5 p-6 rounded-3xl border border-[#C0A06B]/20 flex items-center justify-center relative">
          <img 
            src={selectedVariant?.image || product.mainImage} 
            alt={product.name}
            className="max-h-[450px] w-auto object-contain rounded-2xl transition-all duration-300"
          />
        </div>

        {/* 🛍️ Dynamic Product Attributes */}
        <div className="space-y-6">
          <h1 className="text-3xl font-extrabold text-[#1E2533]">{product.name}</h1>
          <p className="text-2xl font-bold text-[#C0A06B]">৳ {product.price}</p>

          {/* 🚚 Instant Delivery Calculator */}
          <div className="p-4 bg-gray-50 border border-gray-200 rounded-2xl space-y-2 text-xs">
            <div className="flex justify-between items-center">
              <span className="font-bold">Select Delivery Location:</span>
