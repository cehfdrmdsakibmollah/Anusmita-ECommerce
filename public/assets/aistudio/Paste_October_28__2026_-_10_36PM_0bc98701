  // সিমুলেটেড সাইজ ক্যালকুলেটর লজিক
  const calculateSize = () => {
    if (!height || !weight) return;
    // সাধারণ একটি ডামি ফর্মুলা
    const size = weight > 70 ? 'L' : weight > 60 ? 'M' : 'S';
    setSuggestedSize(size);
  };

  return (
    <div className="max-w-7xl mx-auto px-4 py-6 space-y-8 text-[#1E2533]">
      
