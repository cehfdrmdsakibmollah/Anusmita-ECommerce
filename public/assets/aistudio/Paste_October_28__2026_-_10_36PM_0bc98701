💻 টেকনিক্যাল ইমপ্লিমেন্টেশন কোড (Next.js Component Snippet)
নিচে Tiered Bundle Discount Matrix এবং Verified Size Review Breakdown Bar আপনার প্রোডাক্ট পেজে যুক্ত করার জন্য কোড দেওয়া হলো:
'use client';
import { useState } from 'react';

export default function AdvancedProductPageEnhancements({ product }) {
  const [quantity, setQuantity] = useState(1);

  // ডায়নামিক টায়ার্ড ডিসকাউন্ট ক্যালকুলেটর
  const basePrice = product?.price || 1500;
  const discountRate = quantity >= 3 ? 0.15 : quantity === 2 ? 0.08 : 0;
  const finalPrice = Math.round(basePrice * quantity * (1 - discountRate));

  return (
    <div className="max-w-7xl mx-auto px-4 py-8 space-y-8 text-[#1E2533]">
      
      {/* 🏷️ ১. ডাইনামিক টায়ার্ড ডিসকাউন্ট ম্যাট্রিক্স */}
      <div className="bg-white border border-[#C0A06B]/30 p-6 rounded-3xl shadow-sm space-y-4">
        <div className="flex justify-between items-center">
          <h3 className="text-sm font-extrabold text-[#1E2533]">📦 Bulk & Bundle Savings</h3>
          <span className="text-xs bg-[#C0A06B]/20 text-[#C0A06B] px-3 py-1 rounded-full font-bold">
            {quantity >= 3 ? '15% OFF Applied!' : quantity === 2 ? '8% OFF Applied!' : 'Buy more, save more!'}
          </span>
        </div>

        <div className="flex flex-col md:flex-row justify-between items-center gap-4 bg-[#1E2533]/5 p-4 rounded-2xl border border-gray-200">
          <div className="flex items-center gap-3">
            <span className="text-xs font-bold uppercase text-gray-600">Select Quantity:</span>
            <div className="flex items-center border border-gray-300 rounded-xl overflow-hidden bg-white">
              <button 
                onClick={() => setQuantity(Math.max(1, quantity - 1))}
                className="px-3 py-1.5 font-bold hover:bg-gray-100 transition"
              >
                -
              </button>
              <span className="px-4 py-1.5 font-bold text-xs">{quantity}</span>
              <button 
                onClick={() => setQuantity(quantity + 1)}
                className="px-3 py-1.5 font-bold hover:bg-gray-100 transition"
              >
                +
              </button>
            </div>
          </div>

          <div className="text-right">
            <span className="text-xs text-gray-500 block">Total Calculated Price:</span>
            <span className="text-lg font-black text-[#C0A06B]">৳ {finalPrice.toLocaleString('bn-BD')}</span>
          </div>
        </div>
      </div>

      {/* 📊 ২. সাইজ ফিট অ্যানালাইসিস রিভিউ বার */}
      <div className="bg-[#1E2533]/5 border border-[#C0A06B]/30 p-6 rounded-3xl space-y-3">
        <h4 className="text-xs font-extrabold uppercase tracking-wider text-[#1E2533]">✨ Smart Fit & Size Feedback</h4>
        <p className="text-xs text-gray-600">Based on feedback from 120+ verified Anusmita buyers:</p>
        
        <div className="space-y-2">
          <div className="flex justify-between text-xs font-bold">
            <span>True to Size (88%)</span>
            <span className="text-[#C0A06B]">Perfect Fit</span>
          </div>
          <div className="w-full bg-gray-200 h-2.5 rounded-full overflow-hidden">
            <div className="bg-[#C0A06B] h-full rounded-full" style={{ width: '88%' }}></div>
          </div>
          <div className="flex justify-between text-[10px] text-gray-500">
            <span>Runs Slightly Small (7%)</span>
            <span>Runs Slightly Large (5%)</span>
          </div>
        </div>
      </div>

    </div>
  );
}

